{
  "manifest_version": 3,
  "name": "Krillion Helper",
  "version": "0.5.0",
  "description": "Suggests obscure answers for Krillion and keeps a book of the answers revealed after your dives.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Krillion Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://krillion.io/*"],
      "js": ["content.js", "party-core.js", "party.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
